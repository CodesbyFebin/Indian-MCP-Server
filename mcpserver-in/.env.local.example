# Environment Variables for mcpserver-in

# Database
DATABASE_URL="postgres://user:pass@localhost:5432/mcpserver"

# Authentication
AUTH_SECRET="your-secure-jwt-secret"
AUTH_SERVER_URL="https://auth.mcpserver.in"

# Region (Hard Enforcement)
NEXT_PUBLIC_REGION="asia-south1"
NEXT_PUBLIC_URL="https://www.mcpserver.in"

# Rate Limiting
UPSTASH_REDIS_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_TOKEN="your-upstash-redis-token"

# OAuth
CLIENT_ID="your-client-id"
CLIENT_SECRET="your-client-secret"

# Feature flags
NEXT_PUBLIC_EVIDENCE_ENABLED="true"
NEXT_PUBLIC_COMPLIANCE_ENABLED="true"
